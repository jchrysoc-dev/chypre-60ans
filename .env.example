# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# The same three variables go into Vercel → Project → Settings → Environment Variables.
# Where to find them: Supabase dashboard → Project Settings → API Keys (see docs/SETUP_SUPABASE.md).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL= 
# Publishable key (starts with sb_publishable_). Used for every guest request; RLS applies.
SUPABASE_PUBLISHABLE_KEY= 
# Secret key (starts with sb_secret_). Server only: creates/removes logins when Mum edits the guest list.
SUPABASE_SECRET_KEY= 
