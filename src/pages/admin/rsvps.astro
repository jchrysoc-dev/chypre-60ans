---
/** Replies to the invitation, for organisers only (the middleware checks this). */
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import AdminNav from '../../components/AdminNav.astro';
import { formatDate } from '../../lib/format';
import { loadReplies, tally, type GuestReply } from '../../lib/replies';

const replies = await loadReplies(Astro.locals.supabase);
const counts = tally(replies);
const coming = replies.filter((r) => r.reply?.attending === 'yes' || r.reply?.attending === 'maybe');
const notReplied = replies.filter((r) => !r.reply);
const dietary = replies.filter((r) => r.reply?.dietary);
const flights = coming.filter((r) => r.reply?.flight_in || r.reply?.flight_out);

/** People grouped by a date (arrival or departure), earliest first; unknown dates last. */
function byDate(list: GuestReply[], pick: (r: GuestReply) => string | null | undefined) {
  const groups = new Map<string, GuestReply[]>();
  for (const r of list) {
    const key = pick(r) ?? '';
    groups.set(key, [...(groups.get(key) ?? []), r]);
  }
  return [...groups].sort(([a], [b]) => (a || '9999').localeCompare(b || '9999'));
}
const ROWS = [
  ['yes', 'Coming'],
  ['maybe', 'Maybe'],
  ['no', 'Not coming'],
  ['none', 'Not replied yet'],
] as const;
---

<Layout title="Replies">
  <PageIntro title="Replies" lead="Who is coming to the party, when they arrive, and what they eat." />
  <AdminNav />

  <p><a href="/admin/rsvps.csv" download class="button-quiet">Download all replies (CSV)</a></p>

  <section class="mt-block" aria-labelledby="counts">
    <h2 id="counts" class="text-heading">Count</h2>
    <table class="mt-3 w-full max-w-measure text-left">
      <thead>
        <tr class="border-b border-thread">
          <th class="py-2"></th>
          <th class="py-2">Adults</th>
          <th class="py-2">Children</th>
        </tr>
      </thead>
      <tbody>
        {
          ROWS.map(([key, label]) => (
            <tr class="border-b border-thread">
              <th class="py-2 font-normal">{label}</th>
              <td class="py-2">{counts[key].adults}</td>
              <td class="py-2">{counts[key].children}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="mt-section" aria-labelledby="waiting">
    <h2 id="waiting" class="text-heading">Not replied yet</h2>
    {notReplied.length === 0 ? <p class="mt-2">Everyone has replied.</p> : (
      <ul class="mt-2">
        {notReplied.map((r) => <li>{r.fullName} <span class="text-ink-soft">({r.household})</span></li>)}
      </ul>
    )}
  </section>

  <section class="mt-section" aria-labelledby="arrivals">
    <h2 id="arrivals" class="text-heading">Arrivals and departures</h2>
    <p class="mt-1 text-ink-soft">People coming or maybe coming.</p>
    <div class="mt-3 grid gap-8 sm:grid-cols-2">
      {
        ([['Arriving', (r: GuestReply) => r.reply?.arrival_date], ['Leaving', (r: GuestReply) => r.reply?.departure_date]] as const).map(
          ([heading, pick]) => (
            <div>
              <h3>{heading}</h3>
              <dl class="mt-2">
                {byDate(coming, pick).map(([date, list]) => (
                  <>
                    <dt class="mt-2 font-bold text-clay">{date ? formatDate(date) : 'Date not given'}</dt>
                    <dd>{list.map((r) => r.fullName).join(', ')}</dd>
                  </>
                ))}
              </dl>
            </div>
          ),
        )
      }
    </div>
  </section>

  <section class="mt-section" aria-labelledby="flights">
    <h2 id="flights" class="text-heading">Flights</h2>
    {flights.length === 0 ? <p class="mt-2">No flights given yet.</p> : (
      <ul class="ruled mt-2 max-w-measure">
        {flights.map((r) => (
          <li class="py-2">
            <span class="font-bold">{r.fullName}</span>
            {r.reply?.flight_in && <span class="block">In: {r.reply.flight_in}</span>}
            {r.reply?.flight_out && <span class="block">Out: {r.reply.flight_out}</span>}
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="mt-section" aria-labelledby="dietary">
    <h2 id="dietary" class="text-heading">Dietary needs</h2>
    <p class="mt-1 text-ink-soft">This is health information. Share it only with the caterer, and only what they need.</p>
    {dietary.length === 0 ? <p class="mt-2">None given yet.</p> : (
      <ul class="ruled mt-2 max-w-measure">
        {dietary.map((r) => (
          <li class="py-2">
            <span class="font-bold">{r.fullName}</span>
            {r.reply?.attending === 'no' && <span class="text-ink-soft"> (not coming)</span>}
            <span class="block">{r.reply?.dietary}</span>
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
