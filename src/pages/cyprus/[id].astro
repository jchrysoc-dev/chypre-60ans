---
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';

const resource = await getEntry('cyprus', Astro.params.id ?? '');
if (!resource) return Astro.rewrite('/404');
const { Content } = await render(resource);
---

<Layout title={resource.data.title} description={resource.data.summary}>
  <p class="mb-6"><a href="/cyprus" class="inline-flex min-h-12 items-center">Back to all Cyprus information</a></p>
  <PageIntro title={resource.data.title} lead={resource.data.summary} />
  <div class="prose-site"><Content /></div>
  {
    resource.data.links.length > 0 && (
      <section class="mt-10 max-w-[38rem]" aria-labelledby="links-heading">
        <h2 id="links-heading" class="text-[1.75rem]">Useful links</h2>
        <ul class="mt-3">
          {resource.data.links.map((link) => (
            <li>
              <a href={link.url} rel="noopener" class="inline-flex min-h-12 items-center">{link.label}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
