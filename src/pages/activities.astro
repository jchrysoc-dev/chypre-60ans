---
import { actions } from 'astro:actions';
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Note from '../components/Note.astro';
import SignUpForm from '../components/SignUpForm.astro';
import { ensureActivitiesSynced, getActivities, loadHouseholdView } from '../lib/activities';
import { cyprusDay, formatDate, formatEuros, formatTime } from '../lib/format';

const activities = await getActivities();
await ensureActivitiesSynced();
const view = await loadHouseholdView(Astro.locals.supabase, Astro.locals.person!.household_id);
const saved = Astro.getActionResult(actions.activities.save);
const outcome = saved?.data ?? (saved?.error ? { activityId: undefined, ok: false, message: saved.error.message } : undefined);
const nobodyReplied = !view.members.some((m) => m.attending === 'yes' || m.attending === 'maybe');

// Group by Cyprus calendar day, keeping chronological order.
const days = new Map<string, typeof activities>();
for (const activity of activities) {
  const day = cyprusDay(activity.data.start);
  days.set(day, [...(days.get(day) ?? []), activity]);
}
const rendered = new Map(await Promise.all(activities.map(async (a) => [a.id, (await render(a)).Content] as const)));
---

<Layout title="Activities" description="The programme for the birthday week, with times, costs and places.">
  <PageIntro title="Activities" lead="The programme for the week. Join as many as you like. All times are Cyprus time." />
  {
    nobodyReplied && activities.length > 0 && (
      <Note>
        To sign up for activities, first <a href="/rsvp">reply to the invitation</a> for your household.
      </Note>
    )
  }
  <div aria-live="polite">
    {outcome && !outcome.activityId && <Note tone="error" title="Not saved" class="mt-4">{outcome.message}</Note>}
  </div>
  {
    activities.length === 0 && (
      <Note>The programme isn't ready yet. Activities appear here as soon as they are planned, and you can sign up then.</Note>
    )
  }

  {
    [...days].map(([day, items]) => (
      <section class="mt-section" aria-labelledby={`day-${day}`}>
        <h2 id={`day-${day}`} class="text-heading">
          <time datetime={day}>{formatDate(day)}</time>
        </h2>
        <ol class="ruled mt-4 border-y border-thread">
          {items.map((activity) => {
            const { data } = activity;
            const Content = rendered.get(activity.id)!;
            return (
              <li id={activity.id} class="grid gap-x-8 gap-y-1 py-6 sm:grid-cols-[7rem_1fr]">
                <p>
                  <time datetime={data.start} class="font-display text-time text-clay">
                    {formatTime(data.start)}
                  </time>
                  {data.end && (
                    <span class="mt-1 block text-ink-soft max-sm:ml-3 max-sm:inline">
                      until <time datetime={data.end}>{formatTime(data.end)}</time>
                    </span>
                  )}
                </p>
                <div class="max-w-measure">
                  <h3 class="text-subheading">
                    {data.status === 'cancelled' ? (
                      <>
                        <s>{data.title}</s> <span class="text-clay">Cancelled</span>
                      </>
                    ) : (
                      data.title
                    )}
                  </h3>
                  <p class="mt-1">{data.summary}</p>
                  <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
                    <dt class="text-ink-soft">Meet at</dt>
                    <dd>{data.meeting_point}</dd>
                    <dt class="text-ink-soft">Cost</dt>
                    <dd>
                      {data.cost_eur > 0 ? `${formatEuros(data.cost_eur)} per person` : 'Free'}
                      {data.cost_note && <span class="block text-ink-soft">{data.cost_note}</span>}
                    </dd>
                    <dt class="text-ink-soft">Children</dt>
                    <dd>{data.kid_friendly ? 'Welcome' : 'Adults only'}</dd>
                  </dl>
                  <div class="prose-site mt-3">
                    <Content />
                  </div>
                  <SignUpForm
                    activity={activity}
                    view={view}
                    outcome={outcome?.activityId === activity.id ? outcome : undefined}
                  />
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    ))
  }
</Layout>
