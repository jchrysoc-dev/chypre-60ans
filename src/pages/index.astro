---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import EventFacts from '../components/EventFacts.astro';
import Hero from '../components/Hero.astro';
import LaceBand from '../components/LaceBand.astro';
import { formatDate } from '../lib/format';

const welcome = (await getEntry('pages', 'welcome'))!;
const { data: event } = (await getEntry('event', 'event'))!;
const { Content } = await render(welcome);
---

<Layout title={event.title} description={welcome.data.summary} hideSiteTitle>
  <Hero slot="hero" />

  {/* The invitation overlaps the bottom of the photo. */}
  <section
    aria-labelledby="invitation-heading"
    class="relative z-10 mx-auto -mt-16 max-w-invite bg-paper px-5 py-6 text-center shadow-lifted sm:-mt-24 sm:px-12 sm:py-10"
  >
    <LaceBand tone="honey" />
    <p class="mt-8 text-lead text-ink-soft">You are invited to celebrate</p>
    <h1 id="invitation-heading" class="mt-3 text-display">{event.title}</h1>
    <p class="mt-6 font-display text-date text-clay">
      <time datetime={event.party.date}>{formatDate(event.party.date)}</time>
    </p>
    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <a href="/rsvp" class="button w-full sm:w-auto">Reply to the invitation</a>
      <a href="/activities" class="button-quiet w-full sm:w-auto">See the week's activities</a>
    </div>
    <LaceBand tone="honey" class="mt-8" />
  </section>

  <div class="mx-auto mt-section max-w-invite space-y-section">
    <div class="prose-site"><Content /></div>
    <EventFacts />
  </div>
</Layout>
