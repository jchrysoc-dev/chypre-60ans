---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import EventFacts from '../components/EventFacts.astro';
import LaceBand from '../components/LaceBand.astro';
import { formatDate } from '../lib/format';

const welcome = (await getEntry('pages', 'welcome'))!;
const { data: event } = (await getEntry('event', 'event'))!;
const { Content } = await render(welcome);
---

<Layout title={event.title} description={welcome.data.summary} hideSiteTitle>
  <section aria-labelledby="invitation-heading" class="mx-auto max-w-2xl bg-paper px-5 py-6 text-center shadow-[0_1px_0_var(--color-thread)] sm:px-12 sm:py-10">
    <LaceBand />
    <p class="mt-8 text-[1.15rem] text-ink-soft">You are invited to celebrate</p>
    <h1 id="invitation-heading" class="mt-3 text-[2.6rem] sm:text-[3.75rem]">{event.title}</h1>
    <p class="mt-6 font-display text-[1.9rem] leading-tight text-clay sm:text-[2.4rem]">
      <time datetime={event.party.date}>{formatDate(event.party.date)}</time>
    </p>
    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <a href="/rsvp" class="button w-full sm:w-auto">Reply to the invitation</a>
      <a href="/activities" class="button-quiet w-full sm:w-auto">See the week's activities</a>
    </div>
    <LaceBand class="mt-8" />
  </section>

  <div class="mx-auto mt-12 max-w-2xl space-y-12">
    <div class="prose-site"><Content /></div>
    <EventFacts />
  </div>
</Layout>
