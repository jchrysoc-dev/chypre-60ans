---
/**
 * Who in the visitor's household goes to one activity: a checkbox per person and one
 * Save button. The database checks everything again (capacity, RSVP, children, start time).
 */
import { actions } from 'astro:actions';
import Note from './Note.astro';
import type { Activity, HouseholdView } from '../lib/activities';
import { blockedReason, closedReason, householdBlocked, people, placesHint, placesLine } from '../lib/signups';

interface Props {
  activity: Activity;
  view: HouseholdView;
  /** The outcome of saving this activity just now, if it was this one. */
  outcome?: { ok: boolean; message: string; changed?: boolean };
}
const { activity, view, outcome } = Astro.props;
const { data } = activity;

const counts = view.counts.get(activity.id) ?? { confirmed: 0, waitlisted: 0 };
const mine = view.signups.get(activity.id) ?? new Map();
const ahead = view.ahead.get(activity.id);
const closed = closedReason({ cancelled: data.status === 'cancelled', start: data.start });
const formId = `signup-${activity.id}`;
const hint = placesHint(data.capacity, counts.confirmed);
// Nobody signed up and nobody can be: one sentence instead of a form of greyed-out boxes.
const blockedAll = mine.size === 0 ? householdBlocked(view.members.map((m) => blockedReason(m, data))) : null;

const stateOf = (personId: string) => {
  const status = mine.get(personId);
  if (status === 'confirmed') return 'Going';
  if (status === 'waitlisted') return ahead ? `On the waiting list, ${people(ahead)} ahead` : 'On the waiting list, next in line';
  return undefined;
};
const BLOCKED = { rsvp: 'Reply to the invitation first', 'not-coming': 'Not coming to the party (change the reply)' };
const tone = !outcome ? undefined : !outcome.ok ? 'error' : outcome.changed === false ? 'info' : 'success';
---

<div class="mt-5 border-t border-thread pt-4">
  <p class="font-bold">{placesLine(data.capacity, counts.confirmed, counts.waitlisted)}</p>

  {
    closed ? (
      <>
        <p class="mt-1 text-ink-soft">
          {closed === 'cancelled' ? 'Cancelled, so sign-ups are closed.' : 'This has started, so sign-ups are closed.'}
        </p>
        {mine.size > 0 && (
          <ul class="mt-2">
            {view.members
              .filter((m) => mine.has(m.id))
              .map((m) => (
                <li>
                  {m.full_name}: {stateOf(m.id)}
                </li>
              ))}
          </ul>
        )}
      </>
    ) : blockedAll ? (
      <p class="mt-1 text-ink-soft">
        {blockedAll === 'rsvp' && (
          <>
            <a href="/rsvp">Reply to the invitation</a> first, then you can sign up here.
          </>
        )}
        {blockedAll === 'not-coming' && (
          <>
            Your household isn't coming to the party. <a href="/rsvp">Change the reply</a> to sign up.
          </>
        )}
        {blockedAll === 'child' && 'This one is for adults only.'}
      </p>
    ) : (
      <form id={formId} method="POST" action={`${actions.activities.save}#${activity.id}`} class="mt-1">
        {hint && <p class="text-ink-soft">{hint}</p>}
        <input type="hidden" name="activity_id" value={activity.id} />
        <fieldset class="mt-2">
          <legend class="text-ink-soft">Who is coming from your household?</legend>
          <ul class="mt-1">
            {view.members.map((member) => {
              const signedUp = mine.has(member.id);
              const blocked = signedUp ? null : blockedReason(member, data);
              const state = stateOf(member.id);
              return (
                <li>
                  <label class:list={['flex min-h-tap items-start gap-3 py-2.5', blocked && 'text-ink-soft']}>
                    <input
                      type="checkbox"
                      name="person_id"
                      value={member.id}
                      checked={signedUp}
                      disabled={Boolean(blocked)}
                      class="tick mt-px"
                    />
                    <span>
                      <span class="block">{member.full_name}</span>
                      {state && <span class:list={['block font-bold', state === 'Going' ? 'text-olive' : 'text-clay']}>{state}</span>}
                      {(blocked === 'rsvp' || blocked === 'not-coming') && (
                        <a href="/rsvp" class="block">
                          {BLOCKED[blocked]}
                        </a>
                      )}
                      {blocked === 'child' && <span class="block">Adults only</span>}
                    </span>
                  </label>
                </li>
              );
            })}
          </ul>
        </fieldset>
        <button type="submit" class="button mt-3">Save who's going</button>
      </form>
    )
  }

  <div aria-live="polite">
    {
      outcome && tone && (
        <Note tone={tone} title={outcome.ok ? undefined : 'Not saved'} class="mt-3">
          {outcome.message}
        </Note>
      )
    }
  </div>
</div>
