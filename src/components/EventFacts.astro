---
/** Key party facts, always read from content/event.yaml (the single source of truth). */
import { getEntry } from 'astro:content';
import { formatDate, formatTimeRange, orTbd, isTbd, TO_BE_CONFIRMED } from '../lib/format';

const { data: event } = (await getEntry('event', 'event'))!;
const { party, venue, week } = event;

const time =
  isTbd(party.start) ? TO_BE_CONFIRMED : `${formatTimeRange(party.start, isTbd(party.end) ? undefined : party.end)} (Cyprus time)`;
const place = [venue.name, venue.town].filter((part) => !isTbd(part)).join(', ') || TO_BE_CONFIRMED;
const weekText =
  isTbd(week.start_date) || isTbd(week.end_date)
    ? TO_BE_CONFIRMED
    : `${formatDate(week.start_date)} to ${formatDate(week.end_date)}`;

const rows = [
  { term: 'Time', value: time },
  { term: 'Place', value: place, address: isTbd(venue.address) ? undefined : venue.address, maps: isTbd(venue.maps_url) ? undefined : venue.maps_url },
  { term: 'Dress code', value: orTbd(party.dress_code, (value) => value) },
  { term: 'The whole week', value: weekText },
];
---

<section aria-labelledby="facts-heading" class="max-w-measure">
  <h2 id="facts-heading" class="text-heading">The party</h2>
  <dl class="ruled mt-4 border-y border-thread">
    {
      rows.map((row) => (
        <div class="grid gap-x-6 py-3 sm:grid-cols-[10rem_1fr]">
          <dt class="font-bold">{row.term}</dt>
          <dd class:list={[row.value === TO_BE_CONFIRMED && 'text-ink-soft italic']}>
            {row.value}
            {row.address && <span class="block">{row.address}</span>}
            {row.maps && <a href={row.maps} class="inline-flex min-h-tap items-center">Open the map</a>}
          </dd>
        </div>
      ))
    }
  </dl>
  <p class="mt-4 text-ink-soft">{event.contact_note}</p>
</section>
