---
import { getEntry } from 'astro:content';
import LaceBand from '../components/LaceBand.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** The welcome page's invitation already shows the site title as its heading. */
  hideSiteTitle?: boolean;
  /** Login pages: no navigation, since nothing else is reachable before logging in. */
  bare?: boolean;
}

import { actions } from 'astro:actions';

const { title, description, hideSiteTitle = false, bare = false } = Astro.props;
const person = Astro.locals.person;
const event = await getEntry('event', 'event');
const siteTitle = event!.data.title;

const nav = [
  { href: '/', label: 'Welcome' },
  { href: '/rsvp', label: 'RSVP' },
  { href: '/activities', label: 'Activities' },
  { href: '/accommodation', label: 'Accommodation' },
  { href: '/participants', label: 'Participants' },
  { href: '/cyprus', label: 'Cyprus' },
];
const hasHero = Astro.slots.has('hero');
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    {/* The browser bar colour: must stay equal to --color-linen in tokens.css (a meta tag can't read CSS). */}
    <meta name="theme-color" content="#f8f1e3" />
    {description && <meta name="description" content={description} />}
    <title>{title === siteTitle ? siteTitle : `${title} – ${siteTitle}`}</title>
    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 button">Skip to content</a>
    <header class="mx-auto max-w-page px-gutter pt-5">
      {!hideSiteTitle && <a href="/" class="font-display text-brand text-ink no-underline">{siteTitle}</a>}
      {bare ? <div class="mt-4 border-b border-thread" /> : (
      <nav aria-label="Main" class:list={['border-b border-thread', !hideSiteTitle && 'mt-2']}>
        {/* Phones: two rows of three. Wider screens: one row. */}
        <ul class="flex flex-wrap gap-x-5 nav:grid nav:grid-cols-[repeat(3,auto)] nav:justify-between sm:-ml-3 sm:flex sm:justify-start sm:gap-x-0">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  class:list={[
                    'relative inline-flex min-h-tap items-center font-bold no-underline sm:px-3',
                    isCurrent(item.href)
                      ? 'text-ink after:absolute after:inset-x-0 after:bottom-1.5 after:h-[3px] after:rounded-full after:bg-clay sm:after:inset-x-3'
                      : 'text-sea hover:text-sea-deep',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      )}
    </header>

    {/* Full-width opening photo (the welcome page). It sits outside the page column. */}
    <slot name="hero" />

    <main id="main" class:list={['mx-auto max-w-page px-gutter pb-block', hasHero ? 'pt-0' : 'pt-block']}>
      <slot />
    </main>

    <footer class="mx-auto max-w-page px-gutter pb-10 text-ink-soft">
      {current === '/' ? <hr class="border-thread" /> : <LaceBand />}
      <p class="mt-4 flex flex-wrap gap-x-6 gap-y-1">
        {person && <a href="/me" class="inline-flex min-h-tap items-center">My details</a>}
        {person?.role === 'admin' && <a href="/admin" class="inline-flex min-h-tap items-center">Organisers</a>}
        <a href="/privacy" class="inline-flex min-h-tap items-center">Your privacy</a>
      </p>
      {
        person && (
          <form method="POST" action={'/login' + actions.auth.logout} class="mt-2">
            <span>Logged in as {person.full_name}. </span>
            <button type="submit" class="link-button">Log out</button>
          </form>
        )
      }
    </footer>
    <script>
      // While a form is being sent, its button says "Saving…" (or its data-busy text) and can't be
      // tapped again, so nobody sends twice on a slow phone connection. Forms work without this.
      document.addEventListener('submit', (event) => {
        const form = event.target as HTMLFormElement;
        if (form.dataset.sending) return event.preventDefault();
        form.dataset.sending = 'true';
        const button = event.submitter;
        if (!(button instanceof HTMLButtonElement)) return;
        button.dataset.label = button.textContent ?? '';
        button.textContent = button.dataset.busy ?? 'Saving…';
        button.setAttribute('aria-disabled', 'true');
      });
      // Coming back with the browser's Back button shows the page as it was left: reset it.
      window.addEventListener('pageshow', () => {
        document.querySelectorAll<HTMLFormElement>('form[data-sending]').forEach((form) => delete form.dataset.sending);
        document.querySelectorAll<HTMLButtonElement>('button[data-label]').forEach((button) => {
          button.textContent = button.dataset.label!;
          button.removeAttribute('aria-disabled');
          delete button.dataset.label;
        });
      });
    </script>
  </body>
</html>
